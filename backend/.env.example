# HAL: fake = симулятор (разработка без железа), real = реальные устройства весов
S2L_HAL_BACKEND=fake

# Реальное железо (заполняется на Фазе 1, после разведки протокола)
S2L_SCALE_PORT=/dev/serial/by-id/CHANGE-ME
S2L_SCALE_BAUDRATE=9600
S2L_PRINTER_DEVICE=/dev/usb/lp0

S2L_DB_URL=sqlite:///./data/s2l.db
S2L_HOST=0.0.0.0
S2L_PORT=8000
