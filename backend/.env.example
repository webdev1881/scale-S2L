# HAL: fake = симулятор (разработка без железа), real = реальные устройства весов
S2L_HAL_BACKEND=fake

# Реальное железо (заполняется на Фазе 1, после разведки протокола)
# Встроенный RS232 прибора; проверьте номер порта на своём экземпляре
S2L_SCALE_PORT=/dev/ttyS4
S2L_SCALE_BAUDRATE=19200
S2L_PRINTER_DEVICE=/dev/usb/lp0

# Весоизмерительная часть Aurora S2 (6/15 кг, класс III). Метрологические параметры:
# менять только вместе с реальным прибором.
S2L_SCALE_CAPACITY_G=15000
S2L_SCALE_DIVISION_G=5
S2L_SCALE_FINE_DIVISION_G=2
S2L_SCALE_FINE_RANGE_G=6000
S2L_SCALE_MIN_WEIGHT_G=40

# Относительный путь считается от каталога backend/, а не от того, откуда запущен
# uvicorn. Абсолютный путь пишется с четырьмя слэшами: sqlite:////var/lib/s2l/s2l.db
S2L_DB_URL=sqlite:///data/s2l.db
S2L_HOST=0.0.0.0
S2L_PORT=8000
