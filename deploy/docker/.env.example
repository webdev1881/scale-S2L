# Настройки прибора. Скопировать в /opt/s2l/.env и поправить под железо.
# Все переменные читает backend/app/config.py; здесь только то, что меняется от
# прибора к прибору. Метрология (НПВ, цена деления) — тоже здесь, а не в админке.

# real — драйверы железа, fake — симулятор (для проверки без весов)
S2L_HAL_BACKEND=real

# Весовая плата. На Aurora S2 — встроенный RS232 /dev/ttyS4, 19200 бод.
# С udev-правилом из deploy/udev имя постоянное: /dev/s2l-scale.
S2L_SCALE_PORT=/dev/ttyS4
S2L_SCALE_BAUDRATE=19200

# Принтер этикеток (raw USB). С udev-правилом — /dev/s2l-printer.
S2L_PRINTER_DEVICE=/dev/usb/lp0

# Метрология Aurora S2: 6/15 кг, класс III
S2L_SCALE_CAPACITY_G=15000
S2L_SCALE_DIVISION_G=5
S2L_SCALE_FINE_DIVISION_G=2
S2L_SCALE_FINE_RANGE_G=6000
S2L_SCALE_MIN_WEIGHT_G=40

# Токен для приёма выгрузки из 1С (POST /api/catalog/1c-import). Пусто — выключено.
S2L_IMPORT_TOKEN=
