[Unit]
Description=Aurora S2L kiosk (cage + chromium)
# Бэкенд живёт в контейнере и поднимается самим docker (restart: unless-stopped);
# киоск ждёт службу docker, а не отдельный юнит бэкенда. Если контейнер ещё не
# готов, chromium покажет экран «Оновлення» и переподключится сам.
After=docker.service systemd-user-sessions.service
Wants=docker.service

[Service]
Type=simple
User=s2l
Group=s2l
PAMName=login
TTYPath=/dev/tty7
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WLR_LIBINPUT_NO_DEVICES=1

# cage — вейланд-композитор ровно на одно окно: ни рабочего стола, ни панели,
# ни возможности свернуть киоск. Легче связки X11 + WM.
# -s — разрешить переключение VT (Alt+Ctrl+Fn): по умолчанию cage его блокирует
# вместе с прочим «выходом за пределы приложения», а сервисному доступу
# (консоль на случай сбоя) это как раз нужно.
ExecStart=/usr/bin/cage -s -- /usr/bin/chromium \
  --kiosk \
  --app=http://127.0.0.1:8000/ \
  --noerrdialogs \
  --disable-infobars \
  --disable-pinch \
  --overscroll-history-navigation=0 \
  --disable-features=TranslateUI \
  --check-for-update-interval=31536000
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
