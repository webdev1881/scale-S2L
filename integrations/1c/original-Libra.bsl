// ВЫГРУЗКА НА ВЕСЫ ЧЕРЕЗ HTTP (Libra)

// Кнопка "ВыгрузитьВВесы": собирает JSON и отправляет POST на сервис Libra.
Процедура ДействияФормыВыгрузитьВВесы(Кнопка)

	Если Товары.Количество() = 0 Тогда
		Предупреждение("Нет данных для выгрузки. Нажмите ""Заполнить"".");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Настройка) Тогда
		Настройка = ПолучитьНастройкуПоУмолчанию();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Настройка) Тогда
		Предупреждение("Не найдена настройка подключения (Справочник.SMK_HTTP_Настройки, признак ""По умолчанию"").");
		Возврат;
	КонецЕсли;

	Лог = "";
	ДобавитьВЛог("=== Начало выгрузки на весы (Libra) ===");
	ДобавитьВЛог("Настройка: " + Строка(Настройка) + " | Сервер: " + Настройка.Сервер + " | Ресурс: " + Настройка.Ресурс + " | SSL: " + Настройка.SSL);

	// replace_images и in_stock пока фиксированы (уточняется с Литвиновским при отладке).
	Попытка
		ТелоЗапроса = ПостроитьТелоЗапроса(Ложь);
	Исключение
		ДобавитьВЛог("ОШИБКА при формировании тела запроса: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	ДобавитьВЛог("Тело запроса сформировано, символов: " + СтрДлина(ТелоЗапроса));

	Попытка
		Ответ = ОтправитьЗапросHTTP(Настройка, ТелоЗапроса);
	Исключение
		ДобавитьВЛог("ОШИБКА HTTP-запроса: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Если Ответ = Неопределено Тогда
		ДобавитьВЛог("ОШИБКА: пустой ответ сервиса (Неопределено).");
		Возврат;
	КонецЕсли;

	КодСостояния = Ответ.КодСостояния;
	ТекстОтвета  = Ответ.ПолучитьТелоКакСтроку();
	ДобавитьВЛог("HTTP код состояния: " + КодСостояния);
	ДобавитьВЛог("Ответ сервиса:" + Символы.ПС + ТекстОтвета);

	Если КодСостояния >= 200 И КодСостояния < 300 Тогда
		ДобавитьВЛог(ТекстИтогаВыгрузки(ТекстОтвета));
	Иначе
		ДобавитьВЛог("Сервис весов вернул НЕуспешный код " + КодСостояния + ".");
	КонецЕсли;
	ДобавитьВЛог("=== Готово ===");

КонецПроцедуры

// Кнопка "Проверить связь": GET /health (без авторизации данных, только доступность сервиса).
// В API api1c метода чтения каталога нет - проверить можно только доступность сервиса.
Процедура ДействияФормыПроверитьСвязь(Кнопка)

	Если НЕ ЗначениеЗаполнено(Настройка) Тогда
		Настройка = ПолучитьНастройкуПоУмолчанию();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Настройка) Тогда
		Предупреждение("Не найдена настройка подключения (Справочник.SMK_HTTP_Настройки, признак ""По умолчанию"").");
		Возврат;
	КонецЕсли;

	Лог = "";
	ДобавитьВЛог("=== Проверка связи (GET /health) ===");
	ДобавитьВЛог("Сервер: " + Настройка.Сервер + " | SSL: " + Настройка.SSL);

	Попытка
		Ответ = ЗапросHealth(Настройка);
	Исключение
		ДобавитьВЛог("ОШИБКА связи: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Если Ответ = Неопределено Тогда
		ДобавитьВЛог("ОШИБКА: пустой ответ сервиса.");
		Возврат;
	КонецЕсли;

	ДобавитьВЛог("HTTP код состояния: " + Ответ.КодСостояния);
	ДобавитьВЛог("Ответ: " + Ответ.ПолучитьТелоКакСтроку());
	Если Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300 Тогда
		ДобавитьВЛог("Связь есть.");
	Иначе
		ДобавитьВЛог("Сервис ответил НЕуспешным кодом.");
	КонецЕсли;

КонецПроцедуры

// GET /health на том же сервере, что и выгрузка.
Функция ЗапросHealth(НастройкаПодключения)

	Если НастройкаПодключения.SSL Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	Иначе
		ЗащищенноеСоединение = Неопределено;
	КонецЕсли;

	HTTPСоединение = Новый HTTPСоединение(
		НастройкаПодключения.Сервер, , , , , 30, ЗащищенноеСоединение);

	Заголовки = Новый Соответствие();
	КлючAPI = СокрЛП(Строка(НастройкаПодключения.api_key));
	Если НЕ ПустаяСтрока(КлючAPI) Тогда
		Заголовки.Вставить("X-API-Key", КлючAPI);
	КонецЕсли;

	HTTPЗапрос = Новый HTTPЗапрос("/health", Заголовки);
	Возврат HTTPСоединение.Получить(HTTPЗапрос);

КонецФункции

// Формирует тело запроса POST /api/catalog/1c-import.
Функция ПостроитьТелоЗапроса(ЗаменятьКартинки)

	МассивТоваров = Новый Массив;
	ДетализацияПозиций = "";

	Для Каждого СтрокаТовара Из Товары Цикл
		Если НЕ СтрокаТовара.Выгружать Тогда
			Продолжить;
		КонецЕсли;

		Номенклатура = СтрокаТовара.Номенклатура;

		Товар = Новый Структура;
		Товар.Вставить("name", Лев(СокрЛП(Номенклатура.Наименование), 120));
		Если Номенклатура.Весовой Тогда
			Товар.Вставить("unit", "weight");
		Иначе
			Товар.Вставить("unit", "piece");
		КонецЕсли;
		Товар.Вставить("price", СтрокаТовара.Цена);

		// Сервис ждёт article ЧИСЛОМ (положительное целое), не строкой.
		ЧислоАртикула = АртикулКакЦелое(СтрокаТовара.Артикул);
		Если ЧислоАртикула > 0 Тогда
			Товар.Вставить("article", ЧислоАртикула);
		КонецЕсли;

		Категория = СокрЛП(Строка(Номенклатура.Родитель));
		Если НЕ ПустаяСтрока(Категория) Тогда
			Товар.Вставить("category", Категория);
		КонецЕсли;

		Товар.Вставить("in_stock", Истина);

		Картинка = КартинкаТовараBase64(Номенклатура);
		Если Картинка <> Неопределено Тогда
			Товар.Вставить("image_base64", Картинка.Данные);
			Товар.Вставить("image_format", Картинка.Формат);
			ПометкаФото = "фото:есть";
		Иначе
			ПометкаФото = "фото:нет";
		КонецЕсли;

		МассивТоваров.Добавить(Товар);

		СтрокаЛога = Строка(МассивТоваров.Количество()) + ". арт." + СокрЛП(Строка(СтрокаТовара.Артикул))
			+ " код" + Строка(СтрокаТовара.КодТовара)
			+ " | " + Товар.name
			+ " | цена " + Формат(СтрокаТовара.Цена, "ЧДЦ=2; ЧГ=0")
			+ " | " + Товар.unit + " | " + ПометкаФото;
		Если ПустаяСтрока(ДетализацияПозиций) Тогда
			ДетализацияПозиций = СтрокаЛога;
		Иначе
			ДетализацияПозиций = ДетализацияПозиций + Символы.ПС + СтрокаЛога;
		КонецЕсли;
	КонецЦикла;

	Если НЕ ПустаяСтрока(ДетализацияПозиций) Тогда
		ДобавитьВЛог("Позиции к выгрузке (" + МассивТоваров.Количество() + "):" + Символы.ПС + ДетализацияПозиций);
	КонецЕсли;

	Корень = Новый Структура;
	Корень.Вставить("generated_at", ТекущаяДатаISO());
	Корень.Вставить("replace_images", ЗаменятьКартинки);
	Корень.Вставить("products", МассивТоваров);

	Возврат SMK_HTTP_Сервер.Stringify(Корень);

КонецФункции

// Возвращает Base64 основного изображения номенклатуры и его формат, либо Неопределено.
Функция КартинкаТовараBase64(Номенклатура)

	Попытка
		Хранилище = Номенклатура.ОсновноеИзображение.Хранилище;
		Если Хранилище = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Картинка = Хранилище.Получить();
		Если Картинка = Неопределено ИЛИ Картинка.Вид = ВидКартинки.Пустая Тогда
			Возврат Неопределено;
		КонецЕсли;
		ДвоичныеДанные = Картинка.ПолучитьДвоичныеДанные();
		Если ДвоичныеДанные = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;

		Строка64 = Base64Строка(ДвоичныеДанные);
		Строка64 = СтрЗаменить(Строка64, Символы.ВК, "");
		Строка64 = СтрЗаменить(Строка64, Символы.ПС, "");

		Результат = Новый Структура("Данные, Формат");
		Результат.Данные = Строка64;
		Результат.Формат = ФорматКартинкиПоBase64(Строка64);
		Возврат Результат;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Приводит артикул к положительному целому. Если артикул нечисловой/пустой/не целое - 0.
Функция АртикулКакЦелое(Артикул)
	Стр = СокрЛП(Строка(Артикул));
	Если ПустаяСтрока(Стр) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		ЧислоЗнач = Число(Стр);
	Исключение
		Возврат 0;
	КонецПопытки;
	Если ЧислоЗнач > 0 И Цел(ЧислоЗнач) = ЧислоЗнач Тогда
		Возврат ЧислоЗнач;
	КонецЕсли;
	Возврат 0;
КонецФункции

// Определяет формат картинки по сигнатуре в начале Base64 (без СтрНачинаетсяС - режим 8.2.13).
Функция ФорматКартинкиПоBase64(Строка64)
	Начало = Лев(Строка64, 5);
	Если Начало = "iVBOR" Тогда
		Возврат "png";
	ИначеЕсли Начало = "UklGR" Тогда
		Возврат "webp";
	Иначе
		Возврат "jpg";
	КонецЕсли;
КонецФункции

// Отправляет тело POST-запросом на сервис WASP (api1c).
// Авторизация - заголовок X-API-Key (не Basic), поэтому запрос собираем локально в обработке.
// Хост/порт/SSL берём как есть из настройки (владелец настраивает поле Сервер сам).
Функция ОтправитьЗапросHTTP(НастройкаПодключения, Тело)

	Если НастройкаПодключения.SSL Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	Иначе
		ЗащищенноеСоединение = Неопределено;
	КонецЕсли;

	HTTPСоединение = Новый HTTPСоединение(
		НастройкаПодключения.Сервер, ,
		НастройкаПодключения.Логин, НастройкаПодключения.Пароль, , 60, ЗащищенноеСоединение);

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	КлючAPI = СокрЛП(Строка(НастройкаПодключения.api_key));
	Если НЕ ПустаяСтрока(КлючAPI) Тогда
		Заголовки.Вставить("X-API-Key", КлючAPI);
	КонецЕсли;

	HTTPЗапрос = Новый HTTPЗапрос(НастройкаПодключения.Ресурс, Заголовки);
	HTTPЗапрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Возврат HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);

КонецФункции

// Разбирает ответ сервиса и формирует читаемый итог.
Функция ТекстИтогаВыгрузки(ТекстОтвета)

	Попытка
		Ответ = SMK_HTTP_Сервер.Parse(ТекстОтвета, , Истина);
	Исключение
		Возврат "Выгрузка выполнена. Ответ сервиса:" + Символы.ПС + ТекстОтвета;
	КонецПопытки;

	Итог = "Выгрузка выполнена."
		+ Символы.ПС + "Принято: "   + ЗначениеИзОтвета(Ответ, "received")
		+ Символы.ПС + "Создано: "   + ЗначениеИзОтвета(Ответ, "created")
		+ Символы.ПС + "Обновлено: " + ЗначениеИзОтвета(Ответ, "updated")
		+ Символы.ПС + "Погашено: "  + ЗначениеИзОтвета(Ответ, "deactivated");

	Если ТипЗнч(Ответ) = Тип("Соответствие") И Ответ.Получить("errors") <> Неопределено Тогда
		Ошибки = Ответ.Получить("errors");
		Если ТипЗнч(Ошибки) = Тип("Массив") И Ошибки.Количество() > 0 Тогда
			Итог = Итог + Символы.ПС + "Ошибок по позициям: " + Ошибки.Количество();
		КонецЕсли;
	КонецЕсли;

	Возврат Итог;

КонецФункции

Функция ЗначениеИзОтвета(Ответ, Ключ)
	Если ТипЗнч(Ответ) = Тип("Соответствие") И Ответ.Получить(Ключ) <> Неопределено Тогда
		Возврат Строка(Ответ.Получить(Ключ));
	КонецЕсли;
	Возврат "?";
КонецФункции

// Текущие дата-время в ISO 8601. Значение справочное, влияния на импорт не имеет.
Функция ТекущаяДатаISO()
	Возврат Формат(ТекущаяДата(), "ДФ=""гггг-ММ-ддTЧЧ:мм:сс""");
КонецФункции

// Тип подключения для поиска настройки по умолчанию (Тип_стр в SMK_HTTP_Настройки).
Функция ТипПодключения()
	Возврат "ВыгрузкаНаВесыLibra";
КонецФункции

Функция ПолучитьНастройкуПоУмолчанию()
	Возврат SMK_HTTP_Сервер.ПолучитьНастройкиПодключенияПоУмолчанию(ТипПодключения());
КонецФункции

// Добавляет строку в реквизит формы "Лог" (и дублирует в окно сообщений).
Процедура ДобавитьВЛог(Текст)
	Стр = Формат(ТекущаяДата(), "ДФ=ЧЧ:мм:сс") + "  " + Текст;
	Если ПустаяСтрока(Лог) Тогда
		Лог = Стр;
	Иначе
		Лог = Лог + Символы.ПС + Стр;
	КонецЕсли;
	Сообщить(Стр);
КонецПроцедуры
