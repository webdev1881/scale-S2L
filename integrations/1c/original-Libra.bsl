////////////////////////////////////////////////////////////////////////////////
// СОБЫТИЯ ФОРМЫ

Процедура ПередОткрытием(Отказ, СтандартнаяОбработка)
	мВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
КонецПроцедуры

Процедура ПриОткрытии()

	СписокВесов = Новый СписокЗначений;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	смкВесы.Ссылка КАК Ссылка,
	|	смкВесы.Наименование КАК Наименование
	|ИЗ
	|	Справочник.смкВесы КАК смкВесы
	|ГДЕ
	|	НЕ смкВесы.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокВесов.Добавить(Выборка.Ссылка, Выборка.Наименование);
	КонецЦикла;

	ЭлементыФормы.ПолеВыбораВесы.СписокВыбора = СписокВесов;
	Если СписокВесов.Количество() > 0 Тогда
		ТекущиеВесы = СписокВесов[0].Значение;
	КонецЕсли;
	ЭлементыФормы.ПолеВыбораВесы.ТолькоПросмотр = (СписокВесов.Количество() <= 1);

	Настройка = ПолучитьНастройкуПоУмолчанию();

	ЗаполнитьПостроительОтчета();

КонецПроцедуры

